# --- PostgreSQL ---
# Administrator account (used only to create the databases)
POSTGRES_USER=
POSTGRES_PASSWORD=
# Password shared by the per-service database users (local development only)
SERVICES_DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Grafana (added in week 3) ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
'@ | Set-Content -Path .env.example -Encoding utf8